import { isThreadBodyValid } from "../common/validators/ThreadValidator";
import { QueryArrayResult, QueryOneResult } from "./QueryArrayResult";
import { ThreadItem } from "./ThreadItem";
import { User } from "./User";
import { Thread } from "./Thread";
import { ChatOllama } from "@langchain/ollama";

// Configure Ollama to connect to the container (now using generic model name)
const ollamaHost = process.env.OLLAMA_HOST || 'ollama:11434';  // Changed from host.docker.internal
const ollama = new ChatOllama({ 
  model: process.env.OLLAMA_MODEL || "Aqua_1.0",  // Use environment variable with fallback
  baseUrl: `http://${ollamaHost}`
});

export const createThreadItem = async (
  userId: string | undefined | null,
  threadId: string,
  body: string
): Promise<QueryOneResult<ThreadItem>> => {
  const bodyMsg = isThreadBodyValid(body);
  if (bodyMsg) {
    return {
      messages: [bodyMsg],
    };
  }

  // users must be logged in to post
  if (!userId) {
    return {
      messages: ["User not logged in."],
    };
  }
  const user = await User.findOne({ where :
    { id: userId }
  });

  const thread = await Thread.findOne({ where :
    { id: threadId }
  });
  if (!thread) {
    return {
      messages: ["Thread not found."],
    };
  }

  // Generate AI response with error handling
  let aiResponse;
  try {
    console.log(`Calling Ollama at: http://${ollamaHost} using model: ${ollama.model}`);
    const response = await ollama.predict(body);
    
    const slateNode = {
      type: "paragraph",
      children: [
        {
          text: response,
        }
      ]
    };

    const slateNodesArray = [slateNode];
    aiResponse = JSON.stringify(slateNodesArray);
    
  } catch (error) {
    console.error('Ollama connection failed:', error.message);
    // Create a fallback response instead of failing completely
    const slateNode = {
      type: "paragraph",
      children: [
        {
          text: "AI response temporarily unavailable. Please try again later.",
        }
      ]
    };
    aiResponse = JSON.stringify([slateNode]);
  }

  const threadItem = await ThreadItem.create({
    body,
    user,
    thread,
    aiResponse,
  }).save();
  if (!threadItem) {
    return {
      messages: ["Failed to create ThreadItem."],
    };
  }

  return {
    messages: [`${threadItem.id}`],
  };
};

export const getThreadItemsByThreadId = async (
  threadId: string
): Promise<QueryArrayResult<ThreadItem>> => {
  const threadItems = await ThreadItem.createQueryBuilder("ti")
    .where(`ti."threadId" = :threadId`, { threadId })
    .leftJoinAndSelect("ti.thread", "thread")
    .orderBy("ti.createdOn", "DESC")
    .getMany();

  if (!threadItems) {
    return {
      messages: ["ThreadItems of thread not found."],
    };
  }
  console.log(threadItems);
  return {
    entities: threadItems,
  };
};